        { "name": "crowd", "at": "l05+2.0", "gain": -12, "args": { "d": 3.0, "intensity": 0.8 } }
      ]
    },
    {
      "id": "s05", "beat": "PRIMEIRA FASE", "scene": "street", "transition": "wipe", "ambience": "street",
      "lines": [
        { "id": "l06", "speaker": "narrador", "text": "Você sai na rua pra contar pra alguém. Mas a rua inteira já sabe.", "pauseAfter": 0.25 },
        { "id": "l07", "speaker": "neide", "text": "Ô, meu filho! Já tô vendo passagem pra Paris!" }
      ],
      "sfx": [
        { "name": "gate", "at": 0.0, "gain": -3 },
        { "name": "footsteps", "at": 0.9, "gain": -8, "args": { "d": 2.4, "rate": 2.2 } },
        { "name": "pop", "at": "l07", "gain": -4 }
      ]
    },
    {
      "id": "s06", "beat": "ESCALADA", "scene": "street-busstop", "transition": "whip", "ambience": "street",
      "lines": [
        { "id": "l08", "speaker": "narrador", "text": "No ponto de ônibus, ninguém. Nem passageiro, nem ônibus.", "pauseAfter": 0.3 },
        { "id": "l09", "speaker": "narrador", "text": "O motorista também ficou milionário. Por que ele trabalharia hoje?" }
      ],
      "sfx": [
        { "name": "tick", "at": 0.4, "gain": -6 },
        { "name": "tick", "at": 1.4, "gain": -6 },
        { "name": "tick", "at": 2.4, "gain": -6 },
        { "name": "footsteps", "at": "l09-0.2", "gain": -10, "args": { "d": 3.0, "rate": 1.8 } },
        { "name": "swish", "at": "l09+1.2", "gain": -6 }
      ]
    },
    {
      "id": "s07", "beat": "CONSEQUÊNCIA", "scene": "bakery", "transition": "whip", "ambience": "bakery", "music": "tense",
      "lines": [
        { "id": "l10", "speaker": "narrador", "text": "Aí você entra na padaria pra comemorar com um pãozinho quente.", "pauseAfter": 0.25 },
        { "id": "l11", "speaker": "valdir", "text": "O pão francês hoje tá novecentos reais, chefe." }
      ],
      "sfx": [
        { "name": "footsteps", "at": 0.2, "gain": -9, "args": { "d": 1.6, "rate": 2.2 } },
        { "name": "slide_up", "at": "l11+0.9", "gain": -4 },
        { "name": "slide_up", "at": "l11+1.4", "gain": -3 },
        { "name": "impact", "at": "l11.end-0.4", "gain": 0 },
        { "name": "record_scratch", "at": "l11.end-0.35", "gain": -6 }
      ]
    },
    {
      "id": "s08", "beat": "PROBLEMA CENTRAL", "scene": "graphic", "transition": "zoom", "ambience": null, "music": "curious",
      "lines": [
        { "id": "l12", "speaker": "narrador", "text": "Porque, quando todo mundo tem um milhão, ninguém tem um milhão.", "pauseAfter": 0.3 },
        { "id": "l13", "speaker": "narrador", "text": "Apareceram do nada mais de duzentos e treze trilhões de reais. Quase dezessete vezes tudo o que o Brasil produziu no ano passado inteiro.", "pauseAfter": 0.3 },
        { "id": "l14", "speaker": "narrador", "text": "Só que a quantidade de pão continua a mesma. Isso tem nome: inflação." }
      ],
      "sfx": [
        { "name": "whoosh", "at": "l13", "gain": -4 },
        { "name": "coin", "at": "l13+0.5", "gain": -6 },
        { "name": "coin", "at": "l13+0.8", "gain": -8 },
        { "name": "pop", "at": "l13+4.6", "gain": -4 },
        { "name": "slide_up", "at": "l13+5.2", "gain": -6 },
        { "name": "pop", "at": "l14+0.2", "gain": -4 },
        { "name": "boom", "at": "l14.end-0.7", "gain": -2 }
      ]
    },
    {
      "id": "s09", "beat": "ÚLTIMA SURPRESA", "scene": "street-sunset", "transition": "dip", "ambience": "street", "music": "outro",
      "lines": [
        { "id": "l15", "speaker": "narrador", "text": "Você volta pra casa com um pão de novecentos reais na mão.", "pauseAfter": 0.3 },
        { "id": "l16", "speaker": "narrador", "text": "E o celular vibra de novo.", "pauseAfter": 0.5 },
        { "id": "l17", "speaker": "narrador", "text": "Mais um milhão. E, pela primeira vez na vida, você fica com medo de ficar rico." }
      ],
      "padEnd": 1.4,
      "sfx": [
        { "name": "footsteps", "at": 0.1, "gain": -10, "args": { "d": 2.6, "rate": 1.8 } },
        { "name": "phone_buzz", "at": "l16+0.4", "gain": 0 },
        { "name": "notification", "at": "l17", "gain": -2 },
        { "name": "slide_down", "at": "l17.end-0.6", "gain": -6 }
      ]
    }
