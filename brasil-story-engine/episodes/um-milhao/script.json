      "lines": [
        { "id": "l05", "speaker": "narrador", "text": "Durante a madrugada, cada brasileiro, do recém-nascido ao bisavô, recebeu exatamente a mesma coisa." }
      ],
      "sfx": [
        { "name": "notification", "at": "l05+0.3", "gain": -6, "pan": -0.5 },
