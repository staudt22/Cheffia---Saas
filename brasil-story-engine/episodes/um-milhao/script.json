{
  "id": "um-milhao",
  "title": "E se todo brasileiro ganhasse R$ 1 milhão amanhã?",
  "format": "piloto-60s",
  "language": "pt-BR",
  "defaults": { "pause": 0.2, "shotPadStart": 0.2, "shotPadEnd": 0.35 },
  "tail": 1.2,
  "shots": [
    {
      "id": "s01", "beat": "HOOK", "scene": "bedroom", "transition": "cut", "ambience": "birds", "music": "mystery",
      "padStart": 0.9,
      "lines": [
        { "id": "l01", "speaker": "narrador", "text": "Você acorda numa terça-feira qualquer com o celular vibrando sem parar." }
